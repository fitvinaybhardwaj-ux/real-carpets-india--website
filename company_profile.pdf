         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Poufs and ottomans are a great addition to any living space to </photoshop:LayerName>
                  <photoshop:LayerText>Poufs and ottomans are a great addition to any living space to give comfort for your feet or an additional seating option. Our poufs come in a wide range of constructions including wovens, tufted textures, printed, macramÃ© and crochet.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>POUF              &amp;                   FOOTSTOOLS</photoshop:LayerName>
                  <photoshop:LayerText>POUF              &amp;                   FOOTSTOOLS</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Our</photoshop:LayerName>
                  <photoshop:LayerText>Our</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Product</photoshop:LayerName>
                  <photoshop:LayerText>Product</photoshop:LayerText>
