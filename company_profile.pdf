         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>What </photoshop:LayerName>
                  <photoshop:LayerText>What </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We Do?</photoshop:LayerName>
                  <photoshop:LayerText>We Do?</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Profesional....Work Ideas</photoshop:LayerName>
                  <photoshop:LayerText>Profesional....Work Ideas</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We are Trusted...Quality</photoshop:LayerName>
                  <photoshop:LayerText>We are Trusted...Quality</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Real Carpets India has dedicated designing and        merchandi</photoshop:LayerName>
                  <photoshop:LayerText>Real Carpets India has dedicated designing and        merchandising team which work with customers very closely to develop custom made programs and fashion ideas for them. We provide complete â€œfloor Coveringâ€ solutions to our customers.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We are expert in Hand-Tufted, Hand-Woven, Hand-Crochet &amp; Braide</photoshop:LayerName>
                  <photoshop:LayerText>We are expert in Hand-Tufted, Hand-Woven, Hand-Crochet &amp; Braided constructions. Real Carpets India has an efficient team of experts Technicians,       Managers, Merchandisers &amp; designers to provide best services to our customers. Our team is able to develop fashion ideas from the home brands. We run various fibers through modern &amp; traditional techniques and create fabulous products.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We delight our customers by providing excellent quality product</photoshop:LayerName>
                  <photoshop:LayerText>We delight our customers by providing excellent quality products and services. We offer them right products, at right price, at the right place, at the right time! Real Carpets India has completely integrated manufacturing set-up with organized system and work practices as per international quality          standards. Our aim is to deliver quality products to our customers so that they can stay ahead of their    competitors.</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
