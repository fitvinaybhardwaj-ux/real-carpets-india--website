      <rdf:Description rdf:about=""
            xmlns:photoshop="http://ns.adobe.com/photoshop/1.0/">
         <photoshop:ColorMode>3</photoshop:ColorMode>
         <photoshop:ICCProfile>sRGB IEC61966-2.1</photoshop:ICCProfile>
         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>The </photoshop:LayerName>
                  <photoshop:LayerText>The </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>History</photoshop:LayerName>
                  <photoshop:LayerText>History</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We started our journey way back in 1995, as a supplier of handt</photoshop:LayerName>
                  <photoshop:LayerText>We started our journey way back in 1995, as a supplier of handtufted carpets to various exports in and around Panipat. We established ourself as a prestigious supplier amongst our clients by producing consistent good quality products with 0% rejection which led us to gain confidence to sell our products to overseas customers directly. As a result of constant and meticulous efforts Real Carpets india gained success in the year 2012 by signing its first contract with an Australia based customer. Over the period of time, we expanded our product range &amp; customer base. </photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
