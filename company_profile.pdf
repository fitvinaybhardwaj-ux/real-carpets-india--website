         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Manufacturing</photoshop:LayerName>
                  <photoshop:LayerText>Manufacturing</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>WEAVING &amp; TUFTING</photoshop:LayerName>
                  <photoshop:LayerText>WEAVING &amp; TUFTING</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>MATERIAL SOURCING</photoshop:LayerName>
                  <photoshop:LayerText>MATERIAL SOURCING</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>QUALITY</photoshop:LayerName>
                  <photoshop:LayerText>QUALITY</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>FINISHING &amp; PACKING </photoshop:LayerName>
                  <photoshop:LayerText>FINISHING &amp; PACKING </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We have the required infrastructure to handle 90% to 95% of pro</photoshop:LayerName>
                  <photoshop:LayerText>We have the required infrastructure to handle 90% to 95% of production in-house. We collect our yarns from the most reputed mills across      multiple regions and with the assistance of our production &amp; quality team, we deliver highest quality products to our customers.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>In Handwoven &amp; Tufted categories we have the ability to meet hi</photoshop:LayerName>
                  <photoshop:LayerText>In Handwoven &amp; Tufted categories we have the ability to meet high quality and massive production.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Real Carpets India cordial partnerships assist them in procurin</photoshop:LayerName>
                  <photoshop:LayerText>Real Carpets India cordial partnerships assist them in procuring top quality raw materials directly from the mills with huge cost advantages.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We have been in the industry for over 25 years now, committed t</photoshop:LayerName>
                  <photoshop:LayerText>We have been in the industry for over 25 years now, committed to create and deliver products of quality and excellence.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>To ensure a safe product delivery all finished goods are superv</photoshop:LayerName>
                  <photoshop:LayerText>To ensure a safe product delivery all finished goods are supervised    strictly and safely by our quality team.</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
